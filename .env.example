# Copy to .env and fill in. Never commit .env.
# Reddit requires approval for new API apps (Responsible Builder Policy):
# https://support.reddithelp.com/hc/en-us/articles/42728983564564-Responsible-Builder-Policy
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Format Reddit asks for: <platform>:<app id>:<version> (by /u/<your username>)
REDDIT_USER_AGENT=script:sentiment-analyser:0.1 (by /u/your_username)

# Company news (free personal-use key): https://finnhub.io/register
FINNHUB_API_KEY=

# StockTwits: new developer registrations are currently closed; leave blank.
STOCKTWITS_ACCESS_TOKEN=

# Claude second-pass scoring (optional, paid; enable in config.yaml):
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# SEC EDGAR asks every client to identify itself: "Your Name your@email.com"
SEC_USER_AGENT=
